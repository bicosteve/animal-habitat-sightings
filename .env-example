# Oracle database credentials.
# Copy this file to ".env" and fill in your own values:
#     cp .env-example .env
#
# The .env file is git-ignored and must NOT be committed.

# JDBC connection URL for the Oracle database.
DB_URL=jdbc:oracle:thin:@//your-oracle-host:1521/your-service-name

# Your Oracle database login (e.g. your FIT xlogin00).
DB_USERNAME=your-username

# Your Oracle database password.
DB_PASSWORD=your-password
